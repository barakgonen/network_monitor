<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>traffic-interface-tool</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>traffic-monitor-app</artifactId>

  <dependencies>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>traffic-monitor-app-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring.boot.version}</version>
        <configuration>
          <mainClass>com.example.TrafficMonitorApplication</mainClass>
          <!--
            traffic-tester-app depends on this module's plain classes (com.example.schemas.*).
            Without a classifier, repackage replaces the main jar artifact in place with the
            fat/executable jar (classes nested under BOOT-INF/classes/), which isn't consumable
            as a normal library dependency. The classifier keeps the thin jar as the resolvable
            main artifact; the executable jar is `traffic-monitor-app-<version>-exec.jar`.
          -->
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <environmentVariables>
            <TRAFFIC_TOOL_CONFIG>${project.basedir}/src/test/resources/traffic-tool-test.yml</TRAFFIC_TOOL_CONFIG>
          </environmentVariables>
        </configuration>
        <executions>
          <!--
            Bound to the `test` phase (before `package`), not the default integration-test/verify
            phases. spring-boot-maven-plugin:repackage runs during `package`, and running it in the
            same lifecycle pass immediately before Failsafe's forked JVM starts corrupts Spring's
            test-context annotation resolution ("Failed to find merged annotation for
            BootstrapWith(...)"), reproducible even with zero Surefire tests in this module and
            confirmed absent when Failsafe runs before `package` (or as a fully separate mvn
            invocation). Running Failsafe before repackage sidesteps the interaction entirely.
          -->
          <execution>
            <phase>test</phase>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
