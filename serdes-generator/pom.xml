<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>traffic-interface-tool</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>serdes-generator</artifactId>

  <dependencies>
    <!-- StructSizeCalculator/ReflectiveStructCodec/FixedArrayLengths + the
         @FixedArrayLength/@EnumWireSize annotations this generator mirrors. This is a dev-time
         CLI tool, never deployed as a service, so the transitive Spring weight pulled in by this
         module is a non-issue - the point is reusing tested reflection/sizing logic rather than
         reimplementing it. -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>traffic-monitor-app-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Output model (ProtocolConfig/MessageConfig/TypeConfig/FieldConfig) plus ProtocolIn/
         ProtocolOut/Protocol.loadConfig used for the post-generation self-check - reusing these
         directly guarantees the generator's output can never drift from what the loader accepts. -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>binary-serdes</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.2</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.instancio</groupId>
      <artifactId>instancio-junit</artifactId>
      <version>2.9.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Plain thin jar (ordinary compiled classes, no bundled dependencies) - this is the
           artifact a downstream Maven consumer resolves as a normal library dependency
           (e.g. an external "offline-generator" project depending on this generator plus its own
           separate schemas dependency, or this reactor's own traffic-tester-app test scope for
           RadaRoundTripTest). Main-Class is set here too purely for `java -cp ... GeneratorMain`
           convenience; this jar is not meant to be run via `java -jar` on its own since it has no
           bundled dependencies - see the shade execution below for that. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.example.serdesgenerator.GeneratorMain</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- Standalone, single-file uber jar (classifier "standalone") bundling every runtime
           dependency - transitively includes traffic-monitor-app-core's full Spring Boot tree,
           accepted as a non-issue for a dev-time CLI tool never deployed as a service (mirrors the
           same trade-off already accepted for that module's own dependency above). This is the
           artifact meant for airgapped environments: `java -jar
           serdes-generator-<version>-standalone.jar` with manifest/output flags needs nothing
           else on disk. It deliberately does NOT bundle any concrete schema classes
           (e.g. traffic-tester-app's rada messages) - those are supplied by whoever runs the
           generator, layered on top via `-cp` alongside this jar, keeping the generator itself
           schema-agnostic (GeneratorMain resolves className: entries purely via Class.forName). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>standalone</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.example.serdesgenerator.GeneratorMain</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
